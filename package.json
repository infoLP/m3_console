{
  "name": "m3_console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console M3 (Next.js), extraite de M3 ; le moteur (worker, migrations) reste dans M3.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --cache --cache-location .next/cache/eslint/",
    "test": "node --experimental-test-module-mocks --import tsx --test \"test/*.test.js\" \"test/wiring/*.test.js\" \"src/**/*.test.ts\"",
    "check": "node scripts/check.mjs",
    "user:list": "node outils-console/userAdmin.js --list",
    "user:set": "node outils-console/userAdmin.js --set",
    "user:delete": "node outils-console/userAdmin.js --delete",
    "check:rapide": "node scripts/check.mjs --rapide"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
